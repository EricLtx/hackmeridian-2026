{
  "extraKnownMarketplaces": {
    "stellar-dev": {
      "source": { "source": "github", "repo": "stellar/stellar-dev-skill" }
    }
  },
  "enabledPlugins": {
    "stellar-dev@stellar-dev": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-private.mjs"
          }
        ]
      }
    ]
  }
}
