# Rust's output directory, and the stack canary's (CI job wasm-canary)
target
target-canary

# Local settings
.soroban
.stellar

# Claude Code personal settings
.claude/settings.local.json

# Third-party reference documents, kept locally only
/references/

# Internal scoping and business documents (market study, proposal): local only
/private/

# Demo runner: dependencies and testnet state (keys, addresses), local only
/demo/node_modules/
/demo/.state/

# Web interface: dependencies and build output
/web/node_modules/
/web/dist/
/.claude/worktrees/
# Ledger snapshots the Soroban test host writes when a test Env is dropped.
**/test_snapshots/

# Event indexer: dependencies, journal and exports, local only. The copy the
# web page reads (web/public/history.json) is committed: GitHub Pages serves it.
/indexer/node_modules/
/indexer/.state/
